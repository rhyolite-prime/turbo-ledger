{
    "listeners": [
        {
            "address": "0.0.0.0",
            "port": 7512,
            "https": false
        }
    ],
    "db_clients": [
        {
            "name": "default",
            "rdbms": "postgresql",
            "host": "127.0.0.1",
            "port": 5432,
            "dbname": "TlProvisioner",
            "user": "postgres",
            "passwd": "postgres",
            "is_fast": false,
            "connection_number": 2
        },
        {
            "name": "identity",
            "rdbms": "postgresql",
            "host": "127.0.0.1",
            "port": 5432,
            "dbname": "TlIdentity",
            "user": "postgres",
            "passwd": "postgres",
            "is_fast": false,
            "connection_number": 2
        },
        {
            "name": "accounting",
            "rdbms": "postgresql",
            "host": "127.0.0.1",
            "port": 5432,
            "dbname": "TlAccounting",
            "user": "postgres",
            "passwd": "postgres",
            "is_fast": false,
            "connection_number": 2
        }
    ],
    "app": {
        "number_of_threads": 2,
        "document_root": "",
        "log": {
            "log_path": "",
            "log_level": "INFO"
        }
    },
    "custom_config": {
        "turbo": {
            "context_secret": "dev-only-context-secret-change-me"
        },
        "provisioner": {
            "instance_mode": {
                "read_enabled": true,
                "write_enabled": true,
                "batch_enabled": true
            },
            "static_tenants": [
                { "id": "default",     "name": "Default Tenant", "status": "ACTIVE" },
                { "id": "demo_bank",   "name": "Demo Bank",      "status": "ACTIVE" },
                { "id": "closed_bank", "name": "Closed Bank",    "status": "SUSPENDED" },
                { "id": "rhyolite_prime", "name": "RhyolitePrime", "status": "ACTIVE" }
            ],
            "services": [
                {
                    "name": "Identity",
                    "db_client": "identity",
                    "migrations_dir": "../../Identity/migrations",
                    "seed_admin": true
                },
                {
                    "name": "Accounting",
                    "db_client": "accounting",
                    "migrations_dir": "../../Accounting/migrations"
                }
            ]
        }
    }
}
