      "key": "baseUrl",
      "value": "http://127.0.0.1:7499"
    },
    {
      "key": "tenantId",
      "value": "acme_bank"
    },
    {
      "key": "hostToken",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "commandId",
      "value": ""
